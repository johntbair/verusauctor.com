---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist on verusauctor.com." noindex={true}>
  <section class="max-w-3xl mx-auto px-6 py-24 text-center">
    <h1 class="text-4xl font-bold tracking-tight mb-6">Page not found</h1>
    <p class="text-lg text-text-secondary-light dark:text-text-secondary-dark mb-10">That page does not exist.</p>
    <a href="/" class="inline-block px-8 py-3 bg-accent-light dark:bg-accent-dark text-white rounded-lg font-medium hover:opacity-90 transition-opacity">Go to the home page</a>
  </section>
</Base>
